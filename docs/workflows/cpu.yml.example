name: CPU contracts
on: [push, pull_request]
jobs:
  contracts:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install torch==2.9.1 --index-url https://download.pytorch.org/whl/cpu
      - run: python -m pip install numpy==1.26.0 mujoco==3.5.0 pytest ruff==0.16.6
      - run: PYTHONPATH=src python -m pera check
      - run: PYTHONPATH=src python -m pytest -q
      - run: python tools/check_release.py
      - run: ruff format --check src reproduction tools tests
